__pycache__/
*.pyc

# Built UDF dependency archives are served from object storage / Pages, not git.
runtimes/*/dependencies.zip
checksums.sha256

# Downloaded GitHub Actions artifacts, not sources.
dependency-archives/
github-pages/

# VitePress site (documentation is built in CI).
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Versioned content is generated from the repository and git refs by
# scripts/prepare-docs.mjs. current-version.json hands the resolved current
# version to the VitePress config.
docs/src/
docs/archive/
docs/public/
docs/.vitepress/current-version.json
