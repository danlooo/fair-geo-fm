__pycache__/
*.pyc

# Rendered from process_graph.json.j2 by scripts/build-process-graph.py.
models/*/process_graph.json

# Generated by scripts/build-stac.py; published to Pages and Zenodo.
stac/

# Built UDF dependency archives are served from object storage / Pages, not git.
runtimes/*/dependencies.zip
# Exported model archives (e.g. TerraMind ONNX) are published with the release.
weights/
# Local environment for scripts/export-*-onnx.py.
.venv-export/
checksums.sha256

# Downloaded GitHub Actions artifacts, not sources.
dependency-archives/
github-pages/

# VitePress site (documentation is built in CI).
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Versioned content is generated from the repository and git refs by
# scripts/prepare-docs.mjs. current-version.json hands the resolved current
# version to the VitePress config.
docs/src/
docs/archive/
docs/public/
docs/.vitepress/current-version.json
docs/.vitepress/stac-bases.json
docs/.vitepress/zenodo-records.json
