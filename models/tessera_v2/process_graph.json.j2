{
  "id": "tessera_v2_embeddings",
  "model": {{ config_json | indent(2) }},
  "default_job_options": {
    "driver-memory": "3g",
    "executor-memory": "3g",
    "executor-memoryOverhead": "3g",
    "python-memory": "6g",
    "soft-errors": 0.1,
    "udf-dependency-archives": [
      "{{ runtime_url }}"
    ]
  },
  "process_graph": {
    "loadcollection1": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "B04",
          "B02",
          "B03",
          "B08",
          "B8A",
          "B05",
          "B06",
          "B07",
          "B11",
          "B12",
          "SCL"
        ],
        "id": "SENTINEL2_L2A",
        "properties": {
          "eo:cloud_cover": {
            "process_graph": {
              "lte1": {
                "process_id": "lte",
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": 50
                },
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "west": 4.56,
          "south": 43.61,
          "east": 4.69,
          "north": 43.7,
          "crs": 4326
        },
        "temporal_extent": [
          "2025-01-01",
          "2025-12-31"
        ]
      }
    },
    "loadcollection2": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "VV",
          "VH"
        ],
        "id": "SENTINEL1_GRD",
        "properties": {
          "sat:orbit_state": {
            "process_graph": {
              "eq1": {
                "process_id": "eq",
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": "ASCENDING"
                },
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "west": 4.56,
          "south": 43.61,
          "east": 4.69,
          "north": 43.7,
          "crs": 4326
        },
        "temporal_extent": [
          "2025-01-01",
          "2025-12-31"
        ]
      }
    },
    "sarbackscatter1": {
      "process_id": "sar_backscatter",
      "arguments": {
        "coefficient": "gamma0-ellipsoid",
        "contributing_area": false,
        "data": {
          "from_node": "loadcollection2"
        },
        "elevation_model": null,
        "ellipsoid_incidence_angle": false,
        "local_incidence_angle": false,
        "mask": false,
        "noise_removal": true
      }
    },
    "apply1": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "sarbackscatter1"
        },
        "process": {
          "process_graph": {
            "log1": {
              "process_id": "log",
              "arguments": {
                "base": 10,
                "x": {
                  "from_parameter": "x"
                }
              }
            },
            "multiply1": {
              "process_id": "multiply",
              "arguments": {
                "x": 20,
                "y": {
                  "from_node": "log1"
                }
              }
            },
            "add1": {
              "process_id": "add",
              "arguments": {
                "x": {
                  "from_node": "multiply1"
                },
                "y": 50
              }
            },
            "multiply2": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "add1"
                },
                "y": 200
              }
            },
            "clip1": {
              "process_id": "clip",
              "arguments": {
                "max": 32767,
                "min": 0,
                "x": {
                  "from_node": "multiply2"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "renamelabels1": {
      "process_id": "rename_labels",
      "arguments": {
        "data": {
          "from_node": "apply1"
        },
        "dimension": "bands",
        "target": [
          "VV_ASC",
          "VH_ASC"
        ]
      }
    },
    "resamplecubespatial1": {
      "process_id": "resample_cube_spatial",
      "arguments": {
        "data": {
          "from_node": "renamelabels1"
        },
        "method": "cubic",
        "target": {
          "from_node": "loadcollection1"
        }
      }
    },
    "mergecubes1": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "loadcollection1"
        },
        "cube2": {
          "from_node": "resamplecubespatial1"
        }
      }
    },
    "loadcollection3": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "VV",
          "VH"
        ],
        "id": "SENTINEL1_GRD",
        "properties": {
          "sat:orbit_state": {
            "process_graph": {
              "eq2": {
                "process_id": "eq",
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": "DESCENDING"
                },
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "west": 4.56,
          "south": 43.61,
          "east": 4.69,
          "north": 43.7,
          "crs": 4326
        },
        "temporal_extent": [
          "2025-01-01",
          "2025-12-31"
        ]
      }
    },
    "sarbackscatter2": {
      "process_id": "sar_backscatter",
      "arguments": {
        "coefficient": "gamma0-ellipsoid",
        "contributing_area": false,
        "data": {
          "from_node": "loadcollection3"
        },
        "elevation_model": null,
        "ellipsoid_incidence_angle": false,
        "local_incidence_angle": false,
        "mask": false,
        "noise_removal": true
      }
    },
    "apply2": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "sarbackscatter2"
        },
        "process": {
          "process_graph": {
            "log2": {
              "process_id": "log",
              "arguments": {
                "base": 10,
                "x": {
                  "from_parameter": "x"
                }
              }
            },
            "multiply3": {
              "process_id": "multiply",
              "arguments": {
                "x": 20,
                "y": {
                  "from_node": "log2"
                }
              }
            },
            "add2": {
              "process_id": "add",
              "arguments": {
                "x": {
                  "from_node": "multiply3"
                },
                "y": 50
              }
            },
            "multiply4": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "add2"
                },
                "y": 200
              }
            },
            "clip2": {
              "process_id": "clip",
              "arguments": {
                "max": 32767,
                "min": 0,
                "x": {
                  "from_node": "multiply4"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "renamelabels2": {
      "process_id": "rename_labels",
      "arguments": {
        "data": {
          "from_node": "apply2"
        },
        "dimension": "bands",
        "target": [
          "VV_DESC",
          "VH_DESC"
        ]
      }
    },
    "resamplecubespatial2": {
      "process_id": "resample_cube_spatial",
      "arguments": {
        "data": {
          "from_node": "renamelabels2"
        },
        "method": "cubic",
        "target": {
          "from_node": "loadcollection1"
        }
      }
    },
    "mergecubes2": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "mergecubes1"
        },
        "cube2": {
          "from_node": "resamplecubespatial2"
        }
      }
    },
    "applydimension1": {
      "process_id": "apply_dimension",
      "arguments": {
        "data": {
          "from_node": "mergecubes2"
        },
        "dimension": "t",
        "process": {
          "process_graph": {
            "runudf1": {
              "process_id": "run_udf",
              "arguments": {
                "context": {
                  "weights_url": "https://huggingface.co/geotessera/TESSERA-V-2.0-2B-N/resolve/main/ckpt/student_nano.pt"
                },
                "data": {
                  "from_parameter": "data"
                },
                "runtime": "Python",
                "udf": {{ udf_json }}
              },
              "result": true
            }
          }
        },
        "target_dimension": "bands"
      }
    },
    "saveresult1": {
      "process_id": "save_result",
      "arguments": {
        "data": {
          "from_node": "applydimension1"
        },
        "format": "NetCDF",
        "options": {}
      },
      "result": true
    }
  }
}
