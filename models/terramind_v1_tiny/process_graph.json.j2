{
  "id": "terramind_v1_tiny_embeddings",
  "version": "{{ version }}",
{% if zenodo_url %}  "zenodo_url": "{{ zenodo_url }}",
{% endif %}  "model": {{ config_json | indent(2) }},
  "parameters": {{ parameters_json }},
  "default_job_options": {
    {# 192 float32 output bands on a 224x224 tile are about 38 MB before the
       NetCDF writer materializes a partition, so keep the JVM heaps above the
       default 3g for the six-tile example extent. #}
    "driver-memory": "4g",
    "executor-memory": "4g",
    "executor-memoryOverhead": "2g",
    "python-memory": "6g",
    "executor-cores": 1,
    "soft-errors": 0.1,
    "udf-dependency-archives": [
      "{{ runtime_url }}",
      "{{ weights_url }}"
    ]
  },
  "process_graph": {
    "loadcollection1": {
      "process_id": "load_collection",
      "arguments": {
        "bands": {
          "from_parameter": "s2_bands"
        },
        "id": {
          "from_parameter": "s2_collection_id"
        },
        "properties": {
          "eo:cloud_cover": {
            "process_graph": {
              "lte1": {
                "process_id": "lte",
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": {
                    "from_parameter": "max_cloud_cover"
                  }
                },
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "from_parameter": "spatial_extent"
        },
        "temporal_extent": {
          "from_parameter": "temporal_extent"
        }
      }
    },
    "reducedimension1": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "loadcollection1"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "median1": {
              "process_id": "median",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "loadcollection2": {
      "process_id": "load_collection",
      "arguments": {
        "bands": {
          "from_parameter": "s1_bands"
        },
        "id": {
          "from_parameter": "s1_collection_id"
        },
        "spatial_extent": {
          "from_parameter": "spatial_extent"
        },
        "temporal_extent": {
          "from_parameter": "temporal_extent"
        }
      }
    },
    "sarbackscatter1": {
      "process_id": "sar_backscatter",
      "arguments": {
        {# The coefficient lives in config.json (single source of truth).
           sigma0-ellipsoid, not gamma0: the TerraMind reference notebook
           calibrates to sigma0-ellipsoid, and CDSE's current backend reroutes
           gamma0 to its STAC implementation, which fails with KeyError('url')
           because the SENTINEL1_GRD layer config has no STAC URL. #}
        "coefficient": {{ config.sar_backscatter_coefficient | tojson }},
        "contributing_area": false,
        "data": {
          "from_node": "loadcollection2"
        },
        "elevation_model": null,
        "ellipsoid_incidence_angle": false,
        "local_incidence_angle": false,
        "mask": false,
        "noise_removal": true
      }
    },
    "reducedimension2": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "sarbackscatter1"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "median2": {
              "process_id": "median",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "loadcollection3": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          {
            "from_parameter": "dem_band"
          }
        ],
        "id": {
          "from_parameter": "dem_collection_id"
        },
        "spatial_extent": {
          "from_parameter": "spatial_extent"
        }
      }
    },
    "reducedimension3": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "loadcollection3"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "median3": {
              "process_id": "median",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "resamplecubespatial1": {
      "process_id": "resample_cube_spatial",
      "arguments": {
        "data": {
          "from_node": "reducedimension2"
        },
        "method": "cubic",
        "target": {
          "from_node": "reducedimension1"
        }
      }
    },
    "resamplecubespatial2": {
      "process_id": "resample_cube_spatial",
      "arguments": {
        "data": {
          "from_node": "reducedimension3"
        },
        "method": "bilinear",
        "target": {
          "from_node": "reducedimension1"
        }
      }
    },
    "mergecubes1": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "reducedimension1"
        },
        "cube2": {
          "from_node": "resamplecubespatial1"
        }
      }
    },
    "mergecubes2": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "mergecubes1"
        },
        "cube2": {
          "from_node": "resamplecubespatial2"
        }
      }
    },
    "applyneighborhood1": {
      "process_id": "apply_neighborhood",
      "arguments": {
        "data": {
          "from_node": "mergecubes2"
        },
        "overlap": [
          {
            "dimension": "x",
            "value": 24,
            "unit": "px"
          },
          {
            "dimension": "y",
            "value": 24,
            "unit": "px"
          }
        ],
        "process": {
          "process_graph": {
            "runudf1": {
              "process_id": "run_udf",
              "arguments": {
                "context": {
                  "dem_band": {
                    "from_parameter": "dem_band"
                  }
                },
                "data": {
                  "from_parameter": "data"
                },
                "runtime": "Python",
                "udf": {{ udf_json }}
              },
              "result": true
            }
          }
        },
        "size": [
          {
            "dimension": "x",
            "value": 176,
            "unit": "px"
          },
          {
            "dimension": "y",
            "value": 176,
            "unit": "px"
          }
        ]
      }
    },
    "saveresult1": {
      "process_id": "save_result",
      "arguments": {
        "data": {
          "from_node": "applyneighborhood1"
        },
        "format": "NetCDF",
        "options": {}
      },
      "result": true
    }
  }
}
